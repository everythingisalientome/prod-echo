# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# --- uv / venvs ---
.venv/
venv/
env/

# --- Testing / linting ---
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# --- Echo DB / generated apps / harness runtime state ---
# These are generated locally and must never carry captured or prod-adjacent data.
*.sqlite
*.sqlite3
/harness/data/
/harness/runs/
/echo_db/
/generated_apps/
/runs/

# --- Captures (never commit real or synthetic capture bundles accidentally) ---
*.har
/captures/

# --- Secrets / env ---
.env
.env.*
*.key
*.pem

# --- Editor / OS cruft ---
.vscode/
.idea/
.DS_Store
*.swp

# --- Logs ---
*.log
